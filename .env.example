# Copy the lines you need into .env (never commit .env).

# Local dashboard login (spy_dashboard.py). 12+ characters; the old default is rejected.
SPY_DASHBOARD_PASSWORD=

# Where the scanner writes its logs. Keep this OUTSIDE OneDrive.
SPY_LOG_DIR=C:\SPYData\logs\spy

# WordPress ingest (Argus SPY Dashboard plugin). Same secret goes in wp-config.php.
ARGUS_SPY_INGEST_URL=https://argusclients.com/wp-json/argus-spy/v1/ingest
ARGUS_SPY_INGEST_SECRET=

# Telegram notifier is off unless set to 1.
SPY_ENABLE_TELEGRAM=0
TELEGRAM_BOT_TOKEN=
SPY_TELEGRAM_CHAT_ID=
